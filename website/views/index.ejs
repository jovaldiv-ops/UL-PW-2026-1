<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/dist/css/web.css">
    <title><%= title %> XD</title>
  </head>
  <body class="font-sans">
    <!-- navbar -->
    <nav class="bg-white border-b border-gray-200">
      <div class="mx-auto flex h-16  items-center justify-between px-6">
        <!-- Logo -->
        <a href="/" class="text-2xl font-bold text-primary">
          ULima FIFA
        </a>

        <!-- Desktop -->
        <a
          href="/login"
          class="hidden rounded-lg bg-primary px-5 py-2 text-sm font-semibold text-white hover:opacity-90 md:block"
        >
          Iniciar sesión
        </a>

        <!-- Mobile -->
        <button
          id="menuButton"
          class="text-primary text-2xl md:hidden cursor-pointer"
        >
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </nav>

    <div
      id="mobileMenu"
      class="fixed top-16 left-0 bottom-0 z-50 w-72 -translate-x-full bg-white shadow-xl transition-transform duration-300 ease-in-out md:hidden"
    >
      <a href="/" class="block px-6 py-4 hover:bg-gray-100">
        <i class="fa-solid fa-house mr-3"></i>
        Home
      </a>

      <a href="/about" class="block px-6 py-4 hover:bg-gray-100">
        <i class="fa-solid fa-circle-info mr-3"></i>
        Nosotros
      </a>

      <a href="/players" class="block px-6 py-4 hover:bg-gray-100">
        <i class="fa-solid fa-users mr-3"></i>
        Jugadores
      </a>

      <a href="/contact" class="block px-6 py-4 hover:bg-gray-100">
        <i class="fa-solid fa-envelope mr-3"></i>
        Contacto
      </a>

      <a href="/login" class="block px-6 py-4 hover:bg-primary bg-secondary text-white">
        <i class="fa-solid fa-right-to-bracket mr-3"></i>
        Iniciar sesión
      </a>
    </div>

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="hidden w-1/5 bg-primary text-white md:block">
        <nav class="mt-6">
          <ul class="space-y-1 px-4">
            <li>
              <a href="/" class="flex items-center gap-3 rounded-lg px-4 py-3 transition hover:bg-white/10">
                <i class="fa-solid fa-house w-5"></i>
                <span>Home</span>
              </a>
            </li>

            <li>
              <a href="/about" class="flex items-center gap-3 rounded-lg px-4 py-3 transition hover:bg-white/10">
                <i class="fa-solid fa-circle-info w-5"></i>
                <span>Nosotros</span>
              </a>
            </li>

            <li>
              <a href="/players" class="flex items-center gap-3 rounded-lg px-4 py-3 transition hover:bg-white/10">
                <i class="fa-solid fa-users w-5"></i>
                <span>Jugadores</span>
              </a>
            </li>

            <li>
              <a href="/contact" class="flex items-center gap-3 rounded-lg px-4 py-3 transition hover:bg-white/10">
                <i class="fa-solid fa-envelope w-5"></i>
                <span>Contacto</span>
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <!-- Contenido -->
      <main class="w-full bg-gray-100 p-8 md:w-4/5">
        <h1 class="mb-2 text-4xl font-bold text-primary">
          Bienvenido
        </h1>

        <p class="mb-8 text-gray-600">
          Administra los jugadores, consulta estadísticas y mantén actualizada la información de tu equipo.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          <div class="rounded-xl bg-white p-6 shadow">
            <div class="mb-3 flex items-center gap-3">
              <i class="fa-solid fa-users text-2xl text-primary"></i>
              <h2 class="font-semibold">Jugadores</h2>
            </div>
            <p class="text-sm text-gray-500">
              124 registrados
            </p>
          </div>

          <div class="rounded-xl bg-white p-6 shadow">
            <div class="mb-3 flex items-center gap-3">
              <i class="fa-solid fa-futbol text-2xl text-primary"></i>
              <h2 class="font-semibold">Partidos</h2>
            </div>
            <p class="text-sm text-gray-500">
              18 esta temporada
            </p>
          </div>

          <div class="rounded-xl bg-white p-6 shadow">
            <div class="mb-3 flex items-center gap-3">
              <i class="fa-solid fa-trophy text-2xl text-primary"></i>
              <h2 class="font-semibold">Torneos</h2>
            </div>
            <p class="text-sm text-gray-500">
              5 activos
            </p>
          </div>
        </div>
      </main>
    </div>

    <!-- Footer -->
    <footer class="bg-primary px-6 py-4 text-center text-white md:bg-gray-100 md:text-gray-600">
      <p class="text-sm">
        © 2026 ULima PM. Todos los derechos reservados.
      </p>
    </footer>
    
    <script type="module" src="/dist/js/web.js"></script>

    <script>
      const button = document.getElementById("menuButton");
      const menu = document.getElementById("mobileMenu");

      button.addEventListener("click", () => {
          menu.classList.toggle("-translate-x-full");
      });
    </script>
  </body>
</html>
 