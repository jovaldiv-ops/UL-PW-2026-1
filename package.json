{
  "name": "mi-app-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev-old": "vite",
    "dev": "concurrently --names \"REACT,EXPRESS\" --prefix-colors \"cyan,green\" \"npm run watch\" \"npm run dev-server\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "dev-server": "nodemon --watch server.js server.js",
    "db:new": "npx dbmate -d \"db/migrations\" -e \"DB\" new ",
    "db:up": "npx dbmate -d \"db/migrations\" -e \"DB\" up",
    "db:rollback": "npx dbmate -d \"db/migrations\" -e \"DB\" rollback"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^5.2.1",
    "ejs": "^3.1.9",
    "ejs-mate": "^4.0.0",
    "express-session": "^1.18.2",
    "connect-flash": "^0.1.1",
    "session-file-store": "^1.5.0",
    "morgan": "^1.10.1",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.9.0",
    "nodemon": "^3.1.14",
    "vite": "^5.2.0",
    "dbmate": "^2.26.0"
  }
}
